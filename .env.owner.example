# 複製成 .env.owner1、.env.owner2 ... 後，再搭配 .env.local 使用。
# 這個檔案只放訂閱者/餐廳自己的模板設定，不要放 API_KEY。

export TEMPLATE_ID="test_email"
# 相對路徑可從專案根目錄或 demo 目錄執行腳本。
export TEMPLATE_FILE="templates/test_email.html"
export TEMPLATE_FROM_NAME="丹X漢堡店"
export TEMPLATE_OWNER_NOTIFY_EMAILS="owner@example.com"
export TEMPLATE_REPLY_TO_EMAIL="owner@example.com"

# 不需要設定 ALLOWED_VARIABLES。
# template_manage.sh 會從 SUBJECT 與 BODY 中的 {variable_name} 自動產生它。
